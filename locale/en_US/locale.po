msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "The clean, boxed Manuscript layout that mimics a paper document, with scholarly features: author countries, Dimensions citation badge, issue coverage with flags, article actions, home page cards and back-end helpers."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Accent colour"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Colour of the thin lines under headings and of buttons when hovered. A light colour works best; the header, buttons and links use the Base colour."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "Journal home country"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "Country of the journal, chosen by its full name as on the author form. It is used to show the share of authors from abroad on the Archives and issue pages. Leave it unset to hide that figure."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— not set —"

