msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "Tata letak Manuscript yang bersih dan berbingkai menyerupai dokumen kertas, dengan fitur ilmiah: negara penulis, badge kutipan Dimensions, cakupan terbitan dengan bendera, tombol aksi artikel, kartu beranda, dan alat bantu di sisi admin."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Warna aksen"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Warna garis tipis di bawah judul dan warna tombol saat disorot. Warna terang paling cocok; header, tombol, dan tautan memakai Base colour."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "Negara asal jurnal"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "Negara asal jurnal, dipilih dengan nama lengkap seperti pada formulir penulis. Dipakai untuk menampilkan persentase penulis dari luar negeri di halaman Archives dan terbitan. Biarkan tidak dipilih untuk menyembunyikan angka itu."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— belum dipilih —"

