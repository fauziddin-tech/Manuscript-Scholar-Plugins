msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "Det rene Manuskript-layout i en boks, der imiterer et papirdokument, med videnskabelige funktioner: forfatternes lande, Dimensions-citationsmærke, nummerets dækning med flag, artikelhandlinger, kort på forsiden og hjælpere i administrationen."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Accentfarve"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Farve på de tynde linjer under overskrifter og på knapper ved hover. En lys farve passer bedst; sidehoved, knapper og links bruger grundfarven."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "Tidsskriftets hjemland"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "Tidsskriftets land, valgt ved dets fulde navn som på forfatterformularen. Bruges til at vise andelen af udenlandske forfattere på arkiv- og nummersiderne. Lad feltet være tomt for at skjule tallet."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— ikke valgt —"

