msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "O layout em caixa do Manuscript, limpo e simples, que imita um documento em papel, com recursos acadêmicos: países dos autores, selo de citações do Dimensions, cobertura da edição com bandeiras, ações dos artigos, cartões na página inicial e auxiliares na área administrativa."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Cor de destaque"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Cor das linhas finas sob os títulos e dos botões ao passar o mouse. Uma cor clara funciona melhor; o cabeçalho, os botões e os links usam a cor base."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "País da revista"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "País da revista, escolhido pelo nome completo como no formulário de autor. É usado para mostrar a proporção de autores estrangeiros nas páginas de arquivo e de edição. Deixe sem escolha para ocultar esse número."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— não definido —"

