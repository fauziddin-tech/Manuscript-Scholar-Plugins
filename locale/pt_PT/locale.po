msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "O layout em caixa do Manuscript, limpo e simples, que reproduz uma folha de papel, com funcionalidades académicas: países dos autores, distintivo de citações Dimensions, cobertura do número com bandeiras, ações dos artigos, cartões na página inicial e auxiliares na área de administração."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Cor de destaque"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Cor das linhas finas sob os títulos e dos botões ao passar o rato. Uma cor clara resulta melhor; o cabeçalho, os botões e as ligações usam a cor base."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "País da revista"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "País da revista, escolhido pelo nome completo como no formulário de autor. É usado para mostrar a proporção de autores estrangeiros nas páginas de arquivo e de número. Deixe por definir para ocultar esse valor."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— por definir —"

