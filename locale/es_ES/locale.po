msgid "plugins.themes.manuscriptScholar.name"
msgstr "Manuscript Scholar Plugins"

msgid "plugins.themes.manuscriptScholar.description"
msgstr "El diseño en caja de Manuscript, limpio y sencillo, que imita un documento en papel, con funciones académicas: países de los autores, insignia de citas de Dimensions, cobertura del número con banderas, acciones de artículo, tarjetas en la portada y ayudas en la administración."

msgid "plugins.themes.manuscriptScholar.option.accentColour.label"
msgstr "Color de destacados"

msgid "plugins.themes.manuscriptScholar.option.accentColour.description"
msgstr "Color de las líneas finas bajo los títulos y de los botones al pasar el ratón. Un color claro funciona mejor; la cabecera, los botones y los enlaces usan el color base."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.label"
msgstr "País de la revista"

msgid "plugins.themes.manuscriptScholar.option.homeCountry.description"
msgstr "País de la revista, elegido por su nombre completo como en el formulario de autor. Se usa para mostrar la proporción de autores extranjeros en las páginas de archivo y de número. Déjelo sin elegir para ocultar esa cifra."

msgid "plugins.themes.manuscriptScholar.option.homeCountry.none"
msgstr "— sin elegir —"

