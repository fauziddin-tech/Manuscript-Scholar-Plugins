msgid "plugins.themes.individualizeScholar.name"
msgstr "Individualize Scholar"

msgid "plugins.themes.individualizeScholar.description"
msgstr "O tema Individualize da Publia com as funcionalidades académicas do Manuscript Scholar: países dos autores, distintivo de citações Dimensions, cobertura do número com bandeiras, ações dos artigos, blocos da página inicial e auxiliares na área de administração. Requer o tema Individualize."

msgid "plugins.themes.individualizeScholar.option.homeCountry.label"
msgstr "País da revista"

msgid "plugins.themes.individualizeScholar.option.homeCountry.description"
msgstr "País da revista, escolhido pelo nome completo como no formulário de autor. É usado para mostrar a proporção de autores estrangeiros nas páginas de arquivo e de número. Deixe por definir para ocultar esse valor."

msgid "plugins.themes.individualizeScholar.option.homeCountry.none"
msgstr "— por definir —"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.label"
msgstr "Cartões da página inicial"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.description"
msgstr "Apresentados além dos blocos da página inicial acima: as categorias do número atual logo acima do número atual (ou no fim, quando o número atual não é apresentado) e os artigos mais recentes, mais lidos e mais descarregados no fim da página inicial."

msgid "plugins.themes.individualizeScholar.option.homeBlocks.categories"
msgstr "Categorias do número atual"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.highlights"
msgstr "Artigos mais recentes, mais lidos e mais descarregados"

