msgid "plugins.themes.individualizeScholar.name"
msgstr "Individualize Scholar"

msgid "plugins.themes.individualizeScholar.description"
msgstr "El tema Individualize de Publia con las funciones académicas de Manuscript Scholar: países de los autores, insignia de citas de Dimensions, cobertura del número con banderas, acciones de artículo, bloques de portada y ayudas en la administración. Requiere el tema Individualize."

msgid "plugins.themes.individualizeScholar.option.homeCountry.label"
msgstr "País de la revista"

msgid "plugins.themes.individualizeScholar.option.homeCountry.description"
msgstr "País de la revista, elegido por su nombre completo como en el formulario de autor. Se usa para mostrar la proporción de autores extranjeros en las páginas de archivo y de número. Déjelo sin elegir para ocultar esa cifra."

msgid "plugins.themes.individualizeScholar.option.homeCountry.none"
msgstr "— sin elegir —"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.label"
msgstr "Tarjetas de la portada"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.description"
msgstr "Se muestran además de los bloques de portada anteriores: las categorías del número actual justo encima del número actual (o al final si el número actual no se muestra) y los artículos más recientes, más leídos y más descargados al final de la portada."

msgid "plugins.themes.individualizeScholar.option.homeBlocks.categories"
msgstr "Categorías del número actual"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.highlights"
msgstr "Artículos más recientes, más leídos y más descargados"

