msgid "plugins.themes.individualizeScholar.name"
msgstr "Individualize Scholar"

msgid "plugins.themes.individualizeScholar.description"
msgstr "The Individualize theme by Publia with the scholarly features of Manuscript Scholar: author countries, Dimensions citation badge, issue coverage with flags, article actions, homepage blocks and back-end helpers. Requires the Individualize theme."

msgid "plugins.themes.individualizeScholar.option.homeCountry.label"
msgstr "Journal home country"

msgid "plugins.themes.individualizeScholar.option.homeCountry.description"
msgstr "Country of the journal, chosen by its full name as on the author form. It is used to show the share of authors from abroad on the Archives and issue pages. Leave it unset to hide that figure."

msgid "plugins.themes.individualizeScholar.option.homeCountry.none"
msgstr "— not set —"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.label"
msgstr "Homepage cards"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.description"
msgstr "Shown in addition to the Homepage Blocks above: the categories of the current issue right above the current issue (or at the end when the current issue is not shown), the latest, most read and most downloaded articles at the end of the home page."

msgid "plugins.themes.individualizeScholar.option.homeBlocks.categories"
msgstr "Categories of the current issue"

msgid "plugins.themes.individualizeScholar.option.homeBlocks.highlights"
msgstr "Latest, most read and most downloaded articles"

